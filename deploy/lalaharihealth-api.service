[Unit]
Description=LalahariHealth Django API
After=network.target

[Service]
User=lalahari
Group=www-data
WorkingDirectory=/srv/lalaharihealth/backend
EnvironmentFile=/srv/lalaharihealth/backend/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/srv/lalaharihealth/backend/.venv/bin/gunicorn --workers 2 --timeout 60 --access-logfile - --error-logfile - --bind unix:/run/lalaharihealth/api.sock --umask 007 config.wsgi:application
RuntimeDirectory=lalaharihealth
RuntimeDirectoryMode=0755
Restart=always
RestartSec=5
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
