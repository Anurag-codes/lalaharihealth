SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=api.lalaharihealth.com
CORS_ALLOWED_ORIGINS=https://lalaharihealth.com
CSRF_TRUSTED_ORIGINS=https://lalaharihealth.com,https://api.lalaharihealth.com
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
DB_ENGINE=django.db.backends.postgresql
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60

# Patient email OTP: configure a Gmail / Workspace sender with an App Password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Keep the service account file outside the checkout and public media.
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_FILE=
# This deployment uses a private Unix socket behind Nginx, which sets X-Real-IP.
PATIENT_AUTH_TRUST_PROXY_HEADERS=True

# Contact Us screen in the app
SUPPORT_PHONE_NUMBER=+919818677599
SUPPORT_EMAIL=care@lalaharihealth.com

# Booking and notifications
DOCTOR_MATCH_TARGET_MINUTES=30
PUSH_NOTIFICATIONS_ENABLED=True
APPOINTMENT_REMINDER_MINUTES=30
