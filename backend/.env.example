SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Gmail / Google Workspace SMTP: use an App Password, never a normal password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Firebase project used by both Android and iOS. Credentials file stays outside git.
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_FILE=

# Enable only behind a trusted proxy that overwrites X-Real-IP and blocks direct API access.
PATIENT_AUTH_TRUST_PROXY_HEADERS=False

# Contact Us screen in the app
SUPPORT_PHONE_NUMBER=+919818677599
SUPPORT_EMAIL=care@lalaharihealth.com

# Booking and notifications
DOCTOR_MATCH_TARGET_MINUTES=30
PUSH_NOTIFICATIONS_ENABLED=True
APPOINTMENT_REMINDER_MINUTES=30
